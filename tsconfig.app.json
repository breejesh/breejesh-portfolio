/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "files": [
    "src/main.ts",
    "src/main.server.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.page.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
